{
    "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!**/.git",
            "!dist",
            "!target",
            "!index.node",
            "!pnpm-lock.yaml",
            "!Cargo.lock",
            "!*.yaml"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    }
}
